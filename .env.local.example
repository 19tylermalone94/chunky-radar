# OpenSky Network — OAuth2 client credentials
# https://opensky-network.org/ → account → API client
# Without these the proxy falls back to the anonymous tier (low rate limit).
OPENSKY_CLIENT_ID=
OPENSKY_CLIENT_SECRET=

# FlightAware AeroAPI key (paid per request)
# https://flightaware.com/aeroapi/portal/
# Without this, the profile panel shows OpenSky-only data.
FLIGHTAWARE_API_KEY=
