# OpenSky Network — OAuth2 client credentials
# https://opensky-network.org/ → account → API client
# Without these the proxy falls back to the anonymous tier (low rate limit).
OPENSKY_CLIENT_ID=
OPENSKY_CLIENT_SECRET=

# FlightAware AeroAPI key (paid per request)
# https://flightaware.com/aeroapi/portal/
# Without this, the profile panel shows OpenSky-only data.
FLIGHTAWARE_API_KEY=

# (Optional, browser-visible) Base URL for the standalone OpenSky proxy.
# OpenSky filters major cloud provider IP ranges at the TCP level, so
# /api/states from Vercel times out. Point this at a self-hosted proxy
# (see proxy/README.md). When unset, the client falls back to /api/states
# which only works from a non-blocked host.
# Example: https://your-proxy.example.com
NEXT_PUBLIC_STATES_BASE_URL=
